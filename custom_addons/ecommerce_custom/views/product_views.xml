<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_template_form_view_ecommerce_custom" model="ir.ui.view">
        <field name="name">product.template.form.ecommerce.custom</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='sales']//group[@name='sale']" position="inside">
                <group string="Homepage merchandising" name="ecommerce_homepage_merchandising">
                    <field name="is_featured"/>
                    <field name="is_promotional"/>
                    <field name="promotion_label" invisible="not is_promotional"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
